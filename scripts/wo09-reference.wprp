<WindowsPerformanceRecorder Version="1.0" Author="PC-Care">
 <Profiles>
  <SystemCollector Id="WO09Collector" Name="PC-Care independent qualification">
   <BufferSize Value="64"/><Buffers Value="128"/>
  </SystemCollector>
  <SystemProvider Id="WO09Provider">
   <Keywords><Keyword Value="ProcessThread"/><Keyword Value="Loader"/><Keyword Value="CSwitch"/><Keyword Value="SampledProfile"/><Keyword Value="DiskIO"/><Keyword Value="DiskIOInit"/></Keywords>
  </SystemProvider>
  <Profile Id="WO09.Verbose.File" Name="WO09" Description="Bounded CPU and disk reference with thread scheduling and image rundown, no stacks" DetailLevel="Verbose" LoggingMode="File">
   <Collectors><SystemCollectorId Value="WO09Collector"><SystemProviderId Value="WO09Provider"/></SystemCollectorId></Collectors>
  </Profile>
 </Profiles>
</WindowsPerformanceRecorder>
