<Page
    x:Class="SmartPerformanceDoctor.App.Views.SecureVaultCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PccPagePadding}" MaxWidth="1060" Spacing="18">
            <TextBlock Text="보안 금고" Style="{StaticResource MacPageTitleStyle}"/>
            <TextBlock Text="파일을 암호화해 복사합니다. 원본은 기본으로 보존하며, 내보낼 위치에 같은 이름의 파일이 있으면 중단합니다."
                       Style="{StaticResource MacInlineStatusTextStyle}" TextWrapping="Wrap"/>
            <CheckBox x:Name="SealOriginCheckBox" Content="원본 삭제 사용 불가 · 원본 보호 검증이 필요합니다" IsChecked="False" IsEnabled="False"/>

            <Border Style="{StaticResource MacWindowPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="상태" Style="{StaticResource MacSectionHeaderStyle}"/>
                    <TextBlock x:Name="StateLineText" Style="{StaticResource MacEmphasisValueStyle}"/>
                    <TextBlock x:Name="SecurityStateText" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource SpdAccentBrush}"/>
                    <TextBlock x:Name="SessionCountdownText" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{StaticResource SpdAccentBrush}"/>
                    <TextBlock x:Name="StatusLineText" AutomationProperties.AutomationId="VaultStatus" TextWrapping="Wrap" Style="{StaticResource MacInlineStatusTextStyle}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="보안 금고 상태"/>
                    <TextBlock x:Name="CryptoLineText" AutomationProperties.AutomationId="VaultFormat"
                               Foreground="{StaticResource SpdMutedTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SecurityLineText"
                               Foreground="{StaticResource SpdMutedTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock AutomationProperties.AutomationId="VaultCompatibilityNotice"
                               AutomationProperties.Name="기존 금고 중단 복구 안내"
                               Text="기존 Lab v5는 중단 복구 검증이 필요합니다. 열리지 않으면 원본을 보존하세요. 별도 사본 전환은 현재 격리 시험용이며, 이 화면에서 자동 실행하지 않습니다."
                               Foreground="{StaticResource SpdMutedTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="CreatePanel" Style="{StaticResource MacWindowPanelStyle}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="새 금고 만들기" Style="{StaticResource MacSectionHeaderStyle}"/>
                    <PasswordBox x:Name="CreatePasswordBox" PlaceholderText="마스터 비밀번호 (12자+, 대소문자·숫자·특수문자)"/>
                    <PasswordBox x:Name="CreatePasswordConfirmBox" PlaceholderText="비밀번호 확인"/>
                    <TextBox x:Name="RecoveryHintBox" PlaceholderText="복구 힌트 (선택, 비밀번호 아님)"/>
                    <Button Content="금고 생성" Style="{StaticResource PremiumPrimaryButtonStyle}" Click="CreateVault"/>
                </StackPanel>
            </Border>

            <Border x:Name="UnlockPanel" Style="{StaticResource MacWindowPanelStyle}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="금고 열기" Style="{StaticResource MacSectionHeaderStyle}"/>
                    <PasswordBox x:Name="UnlockPasswordBox" PlaceholderText="마스터 비밀번호"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="잠금 해제" Style="{StaticResource PremiumPrimaryButtonStyle}" Click="UnlockVault"/>
                        <Button Content="읽기 전용으로 열기" Style="{StaticResource MacToolbarButtonStyle}" Click="UnlockReadOnly"
                                ToolTipService.ToolTip="가져오기·삭제는 불가, 내보내기만 가능 (v5 Lab)"/>
                    </StackPanel>
                    <TextBlock Text="복구 코드로 열기" Style="{StaticResource MacSectionHeaderStyle}" Margin="0,8,0,0"/>
                    <TextBlock x:Name="RecoveryHintText" TextWrapping="Wrap"
                               Foreground="{StaticResource SpdMutedTextBrush}"
                               Text="일회용 코드입니다. 복구 후 파일을 별도 위치로 내보내세요. 기존 Lab v4/v5의 비밀번호 변경은 데이터 보호를 위해 제한됩니다."/>
                    <TextBox x:Name="RecoveryKeyBox" PlaceholderText="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX (일회용 복구 코드)"/>
                    <Button Content="복구 코드 잠금 해제" Style="{StaticResource MacToolbarButtonStyle}" Click="UnlockWithRecoveryKey"/>
                </StackPanel>
            </Border>

            <Border x:Name="UnlockedPanel" Style="{StaticResource MacWindowPanelStyle}" Visibility="Collapsed">
                <StackPanel x:Name="UnlockedActionsPanel" Spacing="10">
                    <TextBlock Text="보관 항목" Style="{StaticResource MacSectionHeaderStyle}"/>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                        <Button x:Name="AddFileButton" Content="파일 넣기" Style="{StaticResource PremiumPrimaryButtonStyle}" Click="AddFile" AutomationProperties.Name="보안 금고 파일 넣기"/>
                        <Button Grid.Column="1" x:Name="AddFolderButton" Content="폴더 넣기" Style="{StaticResource MacToolbarButtonStyle}" Click="AddFolder" AutomationProperties.Name="보안 금고 폴더 넣기"/>
                        <Button Grid.Column="2" x:Name="BackButton" Content="뒤로" Style="{StaticResource MacToolbarButtonStyle}" Click="NavigateBack" Visibility="Collapsed"/>
                        <Button Grid.Column="4" Content="금고 잠그기" Style="{StaticResource MacToolbarButtonStyle}" Click="LockVault"/>
                    </Grid>
                    <Expander Header="보안 및 유지 관리" IsExpanded="False">
                        <StackPanel Spacing="10" Padding="0,10,0,0">
                            <TextBlock Text="평소에는 사용할 필요가 없습니다. 무결성 확인, 자격 증명 변경, 레거시 형식 전환 도구입니다."
                                       Style="{StaticResource MacInlineStatusTextStyle}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="무결성 검사" Style="{StaticResource MacToolbarButtonStyle}" Click="VerifyIntegrity"/>
                                <Button x:Name="PasswordChangeButton" AutomationProperties.AutomationId="VaultPasswordChange" Content="비밀번호 변경" Style="{StaticResource MacToolbarButtonStyle}" Click="ChangePassword"
                                        ToolTipService.ToolTip="기존 Lab v4/v5는 중단 시 데이터 보호 검증이 필요하여 변경을 제한합니다."/>
                                <Button Content="복구 코드 재발급" Style="{StaticResource MacToolbarButtonStyle}" Click="ReissueRecoveryCodes"
                                        ToolTipService.ToolTip="비밀번호 확인 후 일회용 복구 코드 10개 재발급"/>
                            </StackPanel>
                            <TextBlock x:Name="PasswordChangeRestrictionText" AutomationProperties.AutomationId="VaultPasswordRestriction"
                                       Text="기존 Lab v4/v5 비밀번호 변경은 제한됩니다. 복구가 필요하면 원본을 보존하고 인증된 사본에서 읽기 전용 회수를 검토하세요."
                                       Visibility="Collapsed" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="저장소 정리" Style="{StaticResource MacToolbarButtonStyle}" Click="CompactPacks"
                                        ToolTipService.ToolTip="pack 파일 재패킹·삭제 표식 제거 (쓰기 세션 필요)"/>
                                <Button Content="활성 상태 복구" Style="{StaticResource MacToolbarButtonStyle}" Click="RepairActivation"
                                        ToolTipService.ToolTip="활성 커밋 마커를 현재 메타 해시로 재작성"/>
                                <Button Content="레거시 금고 마이그레이션" Style="{StaticResource MacToolbarButtonStyle}" Click="MigrateToLabV4"
                                        ToolTipService.ToolTip="레거시 v3 금고를 최신 형식으로 재암호화 복사 (원본 유지)"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="자동 잠금 (분):" VerticalAlignment="Center"/>
                        <ComboBox x:Name="AutoLockMinutesBox" Width="88" SelectionChanged="AutoLockMinutesChanged"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button Content="전체 선택" Style="{StaticResource MacToolbarButtonStyle}" Click="SelectAllEntries"/>
                        <Button Grid.Column="1" Content="선택 해제" Style="{StaticResource MacToolbarButtonStyle}" Click="ClearEntrySelection"/>
                        <TextBlock x:Name="SelectionSummaryText" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{StaticResource SpdMutedTextBrush}" Text="선택된 항목 없음"/>
                    </Grid>
                    <TextBlock x:Name="BreadcrumbText" FontWeight="SemiBold"/>
                    <ListView x:Name="EntryList" AutomationProperties.AutomationId="VaultEntries" Height="360" MinHeight="240" AutomationProperties.Name="금고 파일 및 폴더 다중 선택 목록" SelectionMode="Multiple" DoubleTapped="EntryDoubleTapped"
                              SelectionChanged="EntrySelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Padding="0,4">
                                    <TextBlock Text="{Binding TitleLine}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DetailLine}" Foreground="{StaticResource SpdMutedTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="열기" Style="{StaticResource MacToolbarButtonStyle}" Click="OpenSelectedEntry"/>
                        <Button Content="원본 복원" Style="{StaticResource MacToolbarButtonStyle}" Click="RestoreToOrigin"/>
                        <Button x:Name="ExportEntryButton" Content="선택 항목 내보내기" Style="{StaticResource MacToolbarButtonStyle}" Click="ExportEntry" AutomationProperties.Name="보안 금고 선택 항목 내보내기"/>
                        <Button Content="보안 삭제" Style="{StaticResource MacToolbarButtonStyle}" Click="RemoveFromVault"/>
                    </StackPanel>
                    <TextBlock Foreground="{StaticResource SpdMutedTextBrush}" TextWrapping="Wrap"
                               Text="최상위 폴더(🔒📁)를 선택한 뒤 원본 복원 · 더블클릭: 폴더 안으로 들어가기 · 보안 삭제: 복원 없이 데이터 파기"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
