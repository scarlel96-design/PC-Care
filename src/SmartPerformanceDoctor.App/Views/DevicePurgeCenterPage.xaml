<Page
    x:Class="SmartPerformanceDoctor.App.Views.DevicePurgeCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PccPagePadding}" MaxWidth="960" Spacing="18">
            <StackPanel Spacing="5">
                <TextBlock Text="장치 PURGE 준비 센터" Style="{StaticResource MacPageTitleStyle}"/>
                <TextBlock Text="장치 지원 여부와 안전 조건을 읽기 전용으로 검증합니다. 이 화면은 어떤 디스크 명령도 실행하지 않습니다."
                           Style="{StaticResource MacInlineStatusTextStyle}" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Background="{StaticResource PccCautionSoftBrush}" BorderBrush="#35C78B22" BorderThickness="1" CornerRadius="18" Padding="20">
                <StackPanel Spacing="5">
                    <TextBlock Text="실행 기능은 아직 제공하지 않습니다" Foreground="{StaticResource PccCautionBrush}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="이 단계는 물리 디스크 식별, NVMe Identify·Command Effects·Sanitize Status 로그 수집과 증적 저장만 수행합니다. Purge·Format·볼륨 잠금·부팅 설정 변경은 호출하지 않습니다."
                               Foreground="{StaticResource PccTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MacWindowPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="1 · 대상 디스크 읽기 전용 분석" Style="{StaticResource MacSectionHeaderStyle}"/>
                    <ComboBox x:Name="DriveBox" PlaceholderText="분석할 로컬 드라이브 선택" AutomationProperties.Name="장치 PURGE 분석 드라이브"/>
                    <Button x:Name="AnalyzeButton" Content="지원 상태 분석" Style="{StaticResource PremiumPrimaryButtonStyle}"
                            Click="Analyze" HorizontalAlignment="Left" AutomationProperties.Name="장치 PURGE 지원 상태 분석"/>
                    <TextBlock x:Name="AnalysisStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MacWindowPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="2 · 장치 증적과 제한 사항" Style="{StaticResource MacSectionHeaderStyle}"/>
                    <TextBlock x:Name="DeviceSummaryText" Text="대기 · 로컬 드라이브를 선택해 분석하세요." TextWrapping="Wrap"/>
                    <TextBlock x:Name="MethodSummaryText" Foreground="{StaticResource PccTextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource MacWindowPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="3 · 변조 감지 감사 증적" Style="{StaticResource MacSectionHeaderStyle}"/>
                    <TextBlock Text="분석 결과를 현재 사용자 계정의 DPAPI 보호 키와 HMAC으로 묶어 저장합니다. 저장해도 실행 권한은 생기지 않습니다."
                               Foreground="{StaticResource PccTextMutedBrush}" TextWrapping="Wrap"/>
                    <Button x:Name="AttestButton" Content="감사 증적 저장" Style="{StaticResource MacToolbarButtonStyle}"
                            Click="CreateAttestation" HorizontalAlignment="Left" IsEnabled="False" AutomationProperties.Name="장치 PURGE 감사 증적 저장"/>
                    <TextBlock x:Name="AttestationText" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border x:Name="WinPeExecutionPanel" Style="{StaticResource MacWindowPanelStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <TextBlock Text="4 · WinPE 전용 실행 승인" Style="{StaticResource MacSectionHeaderStyle}"/>
                    <TextBlock Text="이 영역은 WinPE에서만 표시됩니다. 일반 Windows에서는 장치 PURGE 실행을 제공하지 않습니다. 명령 전송 뒤에는 취소할 수 없습니다."
                               Foreground="{StaticResource PccDangerBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AuthorizationText" TextWrapping="Wrap"/>
                    <TextBox x:Name="AuthorizationInput" PlaceholderText="표시된 승인 문구 입력"/>
                    <Button x:Name="AuthorizeButton" Content="일회용 승인 시작" Style="{StaticResource MacToolbarButtonStyle}" Click="AuthorizeForExecution" HorizontalAlignment="Left"/>
                    <ComboBox x:Name="ExecutionMethodBox" SelectedIndex="0" AutomationProperties.Name="장치 PURGE 방식">
                        <ComboBoxItem Content="Crypto Erase" Tag="CryptoErase"/>
                        <ComboBoxItem Content="Block Erase" Tag="BlockErase"/>
                    </ComboBox>
                    <TextBox x:Name="ExecutionConfirmBox" PlaceholderText="최종 실행 문구 입력"/>
                    <Button x:Name="ExecutePurgeButton" Content="WinPE 장치 PURGE 실행" Style="{StaticResource PccDangerButtonStyle}" Click="ExecuteWinPePurge" HorizontalAlignment="Left" IsEnabled="False"/>
                    <ProgressBar x:Name="ExecutionProgressBar" Maximum="100" Height="10"/>
                    <TextBlock x:Name="ExecutionStatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>