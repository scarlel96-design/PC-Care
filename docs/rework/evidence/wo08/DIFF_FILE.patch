diff --git a/src/SmartPerformanceDoctor.Diagnostics/ProcessIdentityRegistry.cs b/src/SmartPerformanceDoctor.Diagnostics/ProcessIdentityRegistry.cs
new file mode 100644
index 0000000..a5e7763
--- /dev/null
+++ b/src/SmartPerformanceDoctor.Diagnostics/ProcessIdentityRegistry.cs
@@ -0,0 +1,72 @@
+using System.Security.Cryptography;
+using System.Text;
+
+namespace SmartPerformanceDoctor.Diagnostics;
+
+/// <summary>Keep raw process identifiers in memory. Export session-local lifetime identifiers only.</summary>
+public sealed class ProcessIdentityRegistry
+{
+    private sealed record Entry(int Pid, DateTimeOffset Start, DateTimeOffset? End, string Id, string Source);
+    private readonly List<Entry> _entries = [];
+    private readonly object _gate = new();
+    private readonly string _salt = Convert.ToHexString(RandomNumberGenerator.GetBytes(32));
+    public bool Truncated { get; private set; }
+    public string? ObserveSnapshot(int pid, DateTimeOffset start, DateTimeOffset observed)
+    {
+        if (pid < 0 || start > observed) return null;
+        lock (_gate)
+        {
+            var exact = _entries.LastOrDefault(x => x.Pid == pid && x.Start == start && (x.End is null || observed < x.End));
+            if (exact is not null) return exact.Id;
+            foreach (var old in _entries.Where(x => x.Pid == pid && x.End is null).ToArray())
+                _entries[_entries.IndexOf(old)] = old with { End = start >= old.Start ? start : observed };
+            return Add(pid, start, "ProcessApiStartTime");
+        }
+    }
+    public string? Start(int pid, DateTimeOffset time)
+    {
+        if (pid < 0) return null;
+        lock (_gate)
+        {
+            var live = _entries.LastOrDefault(x => x.Pid == pid && x.End is null);
+            if (live is not null && time < live.Start) return null;
+            if (live is not null) _entries[_entries.IndexOf(live)] = live with { End = time };
+            return Add(pid, time, "EtwStart");
+        }
+    }
+    public void Stop(int pid, DateTimeOffset time)
+    {
+        lock (_gate)
+        {
+            var entry = _entries.LastOrDefault(x => x.Pid == pid && x.Start <= time && x.End is null);
+            if (entry is not null) _entries[_entries.IndexOf(entry)] = entry with { End = time };
+        }
+    }
+    public string? Resolve(int pid, DateTimeOffset time)
+    {
+        lock (_gate)
+        {
+            var found = _entries.Where(x => x.Pid == pid && x.Start <= time && (x.End is null || time < x.End)).ToArray();
+            return found.Length == 1 ? found[0].Id : null;
+        }
+    }
+    public IReadOnlyList<ProcessLifetime> Export()
+    { lock (_gate) return _entries.Select(x => new ProcessLifetime(x.Id, x.Start, x.End, x.Source)).ToArray(); }
+    private string? Add(int pid, DateTimeOffset start, string source)
+    {
+        if (_entries.Count >= 4096) { Truncated = true; return null; }
+        var id = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes($"{_salt}:{pid}:{start.UtcTicks}:{_entries.Count}")))[..24];
+        _entries.Add(new(pid, start, null, id, source)); return id;
+    }
+}
+public static class ProcessSelection
+{
+    public static IReadOnlyList<ProcessMetric> Select(IEnumerable<ProcessMetric> candidates, int budget)
+    {
+        if (budget is < 1 or > 128) throw new ArgumentOutOfRangeException(nameof(budget));
+        var all = candidates.Where(p => p.WorkingSetBytes >= 0).ToArray();
+        var cpu = all.OrderByDescending(p => p.CpuPercent ?? -1).ThenBy(p => p.Identifier, StringComparer.Ordinal);
+        var memory = all.OrderByDescending(p => p.WorkingSetBytes).ThenBy(p => p.Identifier, StringComparer.Ordinal);
+        return cpu.Take((budget + 1) / 2).Concat(memory.Take(budget / 2)).Concat(cpu).DistinctBy(p => p.Identifier).Take(budget).ToArray();
+    }
+}
diff --git a/src/SmartPerformanceDoctor.Diagnostics/ReferenceComparison.cs b/src/SmartPerformanceDoctor.Diagnostics/ReferenceComparison.cs
new file mode 100644
index 0000000..fcc7394
--- /dev/null
+++ b/src/SmartPerformanceDoctor.Diagnostics/ReferenceComparison.cs
@@ -0,0 +1,59 @@
+namespace SmartPerformanceDoctor.Diagnostics;
+
+public sealed record ReferenceObservation(string Category, bool? Present);
+public sealed record AccuracyMetrics(string Status, int TruePositive, int FalsePositive, int FalseNegative,
+    int TrueNegative, int Unknown, int InsufficientEvidence, int ReferenceMismatch, double? Precision, double? Recall);
+public static class ReferenceComparison
+{
+    public static AccuracyMetrics Evaluate(IReadOnlyList<Finding> findings, IReadOnlyList<ReferenceObservation> reference,
+        bool independentlyCollected, bool windowAligned)
+    {
+        if (!independentlyCollected || !windowAligned || reference.Count == 0)
+            return new("NOT TESTED", 0, 0, 0, 0, reference.Count, 0, 0, null, null);
+        if (reference.Select(r => r.Category).Distinct().Count() != reference.Count) throw new ArgumentException("DuplicateReferenceCategory");
+        int tp = 0, fp = 0, fn = 0, tn = 0, unknown = 0, insufficient = 0, mismatch = 0;
+        foreach (var r in reference)
+        {
+            if (r.Present is null) { unknown++; continue; }
+            var f = findings.Where(f => f.Category == r.Category || f.Category == "NoObservedPressure." + r.Category
+                || f.Category == "Transient." + r.Category || f.Category == "InsufficientEvidence." + r.Category).ToArray();
+            if (f.Length != 1) { mismatch++; continue; }
+            if (f[0].Severity == "Unknown") { insufficient++; continue; }
+            var present = f[0].Category == r.Category;
+            if (present && r.Present.Value) tp++;
+            else if (present) fp++;
+            else if (r.Present.Value) fn++;
+            else tn++;
+        }
+        return new("ControlledReferenceOnly", tp, fp, fn, tn, unknown, insufficient, mismatch,
+            tp + fp > 0 ? (double)tp / (tp + fp) : null, tp + fn > 0 ? (double)tp / (tp + fn) : null);
+    }
+}
+
+public static class DiagnosticPresentation
+{
+    public static string State(string state) => state switch
+    {
+        "Candidate" => "병목 후보 · 재측정 필요", "ExpectedWorkload" => "예상된 고부하 작업",
+        "ConfirmedObservation" => "관측 현상 확인", "Unknown" => "측정 정보 부족",
+        "InsufficientEvidence" => "판단 근거 부족", "ReferenceMismatch" => "참조 측정과 불일치",
+        _ => "측정 관찰"
+    };
+    public static string Category(string category)
+    {
+        var subject = category.Contains("CpuSaturation") ? "CPU 부하" : category.Contains("MemoryPressure") ? "메모리 압박" :
+            category.Contains("DiskIoPressure") ? "디스크 응답 지연" : "프로세스 자원 기여";
+        return category.StartsWith("InsufficientEvidence.") ? subject + " · 판단 근거 부족" :
+            category.StartsWith("NoObservedPressure.") ? subject + " · 측정 구간 내 지속 압박 없음" :
+            category.StartsWith("Transient.") ? subject + " · 일시적 상승" : subject;
+    }
+    public static string Coverage(DiagnosticSnapshot snapshot)
+    {
+        var stats = snapshot.EtwStatistics;
+        var loss = stats is null ? "이벤트 손실 측정 정보 없음" :
+            $"ETW 내부 손실 {stats.NativeEtwEventsLost?.ToString() ?? "미측정"} · 수집 큐 손실 {stats.ApplicationQueueDropped} · 잘못된 이벤트 {stats.MalformedEvents} · 종료 대기 {stats.EventsPendingAtStop}";
+        var permission = snapshot.Errors.Any(e => e.Code == "PermissionDenied") ? " · 권한 부족: 허용된 시스템 카운터만 측정" : "";
+        var reduced = stats?.RangeReduced == true ? " · 이벤트 손실로 ETW 수집 중단, 시스템 카운터 측정 계속" : "";
+        return $"{snapshot.Samples.Count}개 표본 · {snapshot.DurationSeconds:F1}초 · {loss}{permission}{reduced} · 온도·클럭·근본 원인 미확인";
+    }
+}
