@@ -0,0 +1,66 @@
+name: WO04 Windows final validation
+
+on:
+  push:
+    branches:
+      - codex/pccare-rework-phase1-final-validation
+    paths-ignore:
+      - 'docs/**'
+      - '.gitattributes'
+  pull_request:
+
+jobs:
+  windows-validation:
+    runs-on: windows-latest
+    timeout-minutes: 55
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '10.0.x'
+      - name: Restore
+        run: dotnet restore SmartPerformanceDoctor.sln -p:Platform=x64
+      - name: Release build
+        run: dotnet build SmartPerformanceDoctor.sln -c Release -p:Platform=x64 --no-restore -m:1 -v:minimal
+      - name: Signed package, publisher, transaction, recovery and staging tests
+        env:
+          VSTEST_CONNECTION_TIMEOUT: '300'
+        run: dotnet test tests/SmartPerformanceDoctor.Tests/SmartPerformanceDoctor.Tests.csproj -c Release -p:Platform=x64 --no-restore -m:1 --filter 'FullyQualifiedName~SignedUpdateTests' --logger 'trx;LogFileName=wo04-signed-updater.trx' -v:minimal
+      - name: Separate-process termination and recovery
+        shell: pwsh
+        run: |
+          dotnet build tests/SmartPerformanceDoctor.UpdateRecoveryProbe/SmartPerformanceDoctor.UpdateRecoveryProbe.csproj -c Release -p:Platform=x64 -m:1 -v:minimal
+          $probe = 'tests/SmartPerformanceDoctor.UpdateRecoveryProbe/bin/x64/Release/net10.0-windows10.0.26100.0/SmartPerformanceDoctor.UpdateRecoveryProbe.exe'
+          $fixture = Join-Path $env:RUNNER_TEMP 'wo04-synthetic-recovery'
+          & $probe prepare $fixture
+          if ($LASTEXITCODE -ne 0) { throw 'prepare failed' }
+          & $probe apply-kill $fixture
+          if ($LASTEXITCODE -eq 0) { throw 'process did not terminate at injection point' }
+          & $probe recover $fixture
+          if ($LASTEXITCODE -ne 0) { throw 'separate-process recovery failed' }
+          & $probe verify $fixture
+          if ($LASTEXITCODE -ne 0) { throw 'restored content verification failed' }
+      - name: Full application regression
+        env:
+          VSTEST_CONNECTION_TIMEOUT: '300'
+        run: dotnet test tests/SmartPerformanceDoctor.Tests/SmartPerformanceDoctor.Tests.csproj -c Release -p:Platform=x64 --no-build --no-restore -m:1 --logger 'trx;LogFileName=wo04-full.trx' -v:minimal
+      - name: SecurityLab regression
+        env:
+          VSTEST_CONNECTION_TIMEOUT: '300'
+        run: dotnet test tests/SmartPerformanceDoctor.SecurityLab.Tests/SmartPerformanceDoctor.SecurityLab.Tests.csproj -c Release -p:Platform=x64 --no-restore -m:1 --logger 'trx;LogFileName=wo04-securitylab.trx' -v:minimal
+      - name: Reject unsupported helper verb
+        shell: pwsh
+        run: |
+          $helper = 'src/SmartPerformanceDoctor.UpdateHelper/bin/x64/Release/net10.0-windows10.0.26100.0/SmartPerformanceDoctor.UpdateHelper.exe'
+          $process = Start-Process -FilePath $helper -ArgumentList @('--exec', 'arbitrary') -Wait -PassThru -NoNewWindow
+          if ($process.ExitCode -ne 2) { throw "Unexpected helper exit code: $($process.ExitCode)" }
+      - name: Upload test evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: wo04-windows-trx
+          path: |
+            tests/SmartPerformanceDoctor.Tests/TestResults/*.trx
+            tests/SmartPerformanceDoctor.SecurityLab.Tests/TestResults/*.trx
diff --git a/scripts/wo04-vm-evidence.ps1 b/scripts/wo04-vm-evidence.ps1
new file mode 100644
index 0000000..eb9d0b6
--- /dev/null
+++ b/scripts/wo04-vm-evidence.ps1
@@ -0,0 +1,32 @@
+param(
+    [Parameter(Mandatory=$true)][string]$InstallRoot,
+    [Parameter(Mandatory=$true)][string]$EvidenceDirectory,
+    [Parameter(Mandatory=$true)][string]$SnapshotId,
+    [Parameter(Mandatory=$true)][ValidateSet('before','after')][string]$Phase
+)
+$ErrorActionPreference = 'Stop'
+$install = (Resolve-Path -LiteralPath $InstallRoot).Path
+$evidence = (Resolve-Path -LiteralPath $EvidenceDirectory).Path
+if (!(Test-Path -LiteralPath (Join-Path $evidence '.wo04-disposable-vm'))) {
+    throw 'Missing disposable VM marker; run only inside the prepared test VM.'
+}
+if (!$SnapshotId.Trim()) { throw 'Snapshot evidence is required.' }
+if (Get-ChildItem -LiteralPath $install -Recurse -Force | Where-Object {
+    $_.Attributes -band [IO.FileAttributes]::ReparsePoint
+}) { throw 'Reparse path found; stop and preserve evidence.' }
+$files = @(Get-ChildItem -LiteralPath $install -File -Recurse -Force | ForEach-Object {
+    [pscustomobject]@{ Path=$_.FullName.Substring($install.Length); Length=$_.Length;
+        Sha256=(Get-FileHash -LiteralPath $_.FullName -Algorithm SHA256).Hash }
+})
+$state = [pscustomobject]@{ Phase=$Phase; SnapshotId=$SnapshotId; Utc=[DateTime]::UtcNow.ToString('o');
+    InstallRoot=$install; WindowsVersion=[Environment]::OSVersion.Version.ToString();
+    Elevated=([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
+        [Security.Principal.WindowsBuiltInRole]::Administrator); Files=$files }
+$state | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $evidence "$Phase-files.json") -Encoding utf8
+$protected = Join-Path $env:ProgramData 'PC-Care/UpdateTransactions'
+if (Test-Path -LiteralPath $protected) {
+    Get-Acl -LiteralPath $protected | Format-List Owner,Sddl,AccessToString |
+        Out-File -LiteralPath (Join-Path $evidence "$Phase-acl.txt") -Encoding utf8
+}
+Write-Output "CAPTURED phase=$Phase files=$($files.Count) snapshot=$SnapshotId"
+# This collector does not install, delete, reboot, approve UAC, or certify test results.
