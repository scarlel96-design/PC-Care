+& (Join-Path $PSScriptRoot 'wo16-ui-source-validation.ps1')
+if (-not $?) { throw 'Vault gate regression failed' }
+Write-Output 'WO17_STORAGE_IDS=6;DELETE_RESULT_STATE=CONNECTED;FOLDER_EXECUTION=DISABLED;GUI=NOT_TESTED'
