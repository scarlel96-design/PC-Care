diff --git a/.github/workflows/wo06-windows-validation.yml b/.github/workflows/wo06-windows-validation.yml
new file mode 100644
index 0000000..22486f5
--- /dev/null
+++ b/.github/workflows/wo06-windows-validation.yml
@@ -0,0 +1,90 @@
+name: WO06 Windows bootstrap recovery
+
+on:
+  push:
+    branches:
+      - codex/pccare-rework-phase1-bootstrap-recovery
+    paths-ignore:
+      - 'docs/**'
+      - '.gitattributes'
+  pull_request:
+
+jobs:
+  windows-validation:
+    runs-on: windows-latest
+    timeout-minutes: 55
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-dotnet@v4
+        with:
+          dotnet-version: '10.0.x'
+      - name: Restore
+        run: dotnet restore SmartPerformanceDoctor.sln -p:Platform=x64
+      - name: Release build
+        run: dotnet build SmartPerformanceDoctor.sln -c Release -p:Platform=x64 --no-restore -m:1 -v:minimal
+      - name: Signed package, publisher, transaction, recovery and staging tests
+        env:
+          VSTEST_CONNECTION_TIMEOUT: '300'
+        run: dotnet test tests/SmartPerformanceDoctor.Tests/SmartPerformanceDoctor.Tests.csproj -c Release -p:Platform=x64 --no-restore -m:1 --filter 'FullyQualifiedName~SignedUpdateTests|FullyQualifiedName~WindowsFileBoundaryTests|FullyQualifiedName~WO05CompatibilityTests|FullyQualifiedName~WO06' --logger 'trx;LogFileName=wo06-signed-updater.trx' -v:minimal
+      - name: Separate-process termination and recovery
+        shell: pwsh
+        run: |
+          dotnet build tests/SmartPerformanceDoctor.UpdateRecoveryProbe/SmartPerformanceDoctor.UpdateRecoveryProbe.csproj -c Release -p:Platform=x64 -m:1 -v:minimal
+          ./scripts/wo06-process-validation.ps1 -OutputDirectory artifacts/wo06-ci-process
+      - name: Production profile and isolated test profile
+        shell: pwsh
+        run: |
+          dotnet build tools/SmartPerformanceDoctor.VMTestKit/SmartPerformanceDoctor.VMTestKit.csproj -c Release -p:Platform=x64 -m:1 -v:minimal
+          if ($LASTEXITCODE -ne 0) { throw 'test kit build failed' }
+          dotnet build tools/SmartPerformanceDoctor.VaultRecovery/SmartPerformanceDoctor.VaultRecovery.csproj -c Release -p:Platform=x64 -m:1 -v:minimal
+          if ($LASTEXITCODE -ne 0) { throw 'data recovery build failed' }
+          $kit = 'tools/SmartPerformanceDoctor.VMTestKit/bin/x64/Release/net10.0-windows10.0.26100.0/SmartPerformanceDoctor.VMTestKit.exe'
+          $engine = 'src/SmartPerformanceDoctor.UpdateEngine/bin/x64/Release/net10.0-windows10.0.26100.0/SmartPerformanceDoctor.UpdateEngine.dll'
+          & $kit audit-production $engine
+          if ($LASTEXITCODE -ne 0) { throw 'test trust leaked into production' }
+          & $kit audit-production 'src/SmartPerformanceDoctor.App/bin/x64/Release/net10.0-windows10.0.26100.0/SmartPerformanceDoctor.dll'
+          if ($LASTEXITCODE -ne 0) { throw 'test profile leaked into production app' }
+          & $kit audit-production 'src/SmartPerformanceDoctor.UpdateHelper/bin/x64/Release/net10.0-windows10.0.26100.0/SmartPerformanceDoctor.UpdateHelper.dll'
+          if ($LASTEXITCODE -ne 0) { throw 'test profile leaked into production helper' }
+          $profile = Join-Path $env:RUNNER_TEMP 'wo06-test-profile'
+          & $kit fixture-profile $profile ('0' * 40)
+          if ($LASTEXITCODE -ne 0) { throw 'profile generation failed' }
+          $source = Join-Path $profile 'TestVmTrust.g.cs'
+          dotnet build src/SmartPerformanceDoctor.UpdateEngine/SmartPerformanceDoctor.UpdateEngine.csproj -c Release -p:Platform=x64 -p:WO05VMTest=true "-p:WO05TestTrustSource=$source" --no-restore -o (Join-Path $profile 'output') -v:minimal
+          if ($LASTEXITCODE -ne 0) { throw 'test profile build failed' }
+          & $kit audit-production (Join-Path $profile 'output/SmartPerformanceDoctor.UpdateEngine.dll')
+          if ($LASTEXITCODE -ne 6) { throw 'production audit accepted a VM test artifact' }
+          dotnet build src/SmartPerformanceDoctor.App/SmartPerformanceDoctor.App.csproj -c Release -p:Platform=x64 -p:WO05VMTest=true "-p:WO05TestTrustSource=$source" --no-restore -m:1 -o (Join-Path $profile 'app-output') -v:minimal
+          if ($LASTEXITCODE -ne 0) { throw 'VM Release application profile build failed' }
+          & $kit audit-production (Join-Path $profile 'app-output/SmartPerformanceDoctor.dll')
+          if ($LASTEXITCODE -ne 6) { throw 'production audit accepted a VM test application' }
+          & $kit audit-production (Join-Path $profile 'app-output/engine/SmartPerformanceDoctor.UpdateHelper.dll')
+          if ($LASTEXITCODE -ne 6) { throw 'VM application copied a production update helper' }
+          & $kit audit-production (Join-Path $profile 'app-output/engine/SmartPerformanceDoctor.UpdateEngine.dll')
+          if ($LASTEXITCODE -ne 6) { throw 'VM helper copied a production update engine' }
+          exit 0
+      - name: Full application regression
+        env:
+          VSTEST_CONNECTION_TIMEOUT: '300'
+        run: dotnet test tests/SmartPerformanceDoctor.Tests/SmartPerformanceDoctor.Tests.csproj -c Release -p:Platform=x64 --no-build --no-restore -m:1 --logger 'trx;LogFileName=wo06-full.trx' -v:minimal
+      - name: SecurityLab regression
+        env:
+          VSTEST_CONNECTION_TIMEOUT: '300'
+        run: dotnet test tests/SmartPerformanceDoctor.SecurityLab.Tests/SmartPerformanceDoctor.SecurityLab.Tests.csproj -c Release -p:Platform=x64 --no-restore -m:1 --logger 'trx;LogFileName=wo06-securitylab.trx' -v:minimal
+      - name: Reject unsupported helper verb
+        shell: pwsh
+        run: |
+          $helper = 'src/SmartPerformanceDoctor.UpdateHelper/bin/x64/Release/net10.0-windows10.0.26100.0/SmartPerformanceDoctor.UpdateHelper.exe'
+          $process = Start-Process -FilePath $helper -ArgumentList @('--exec', 'arbitrary') -Wait -PassThru -NoNewWindow
+          if ($process.ExitCode -ne 2) { throw "Unexpected helper exit code: $($process.ExitCode)" }
+      - name: Upload test evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: wo06-windows-trx
+          path: |
+            tests/SmartPerformanceDoctor.Tests/TestResults/*.trx
+            tests/SmartPerformanceDoctor.SecurityLab.Tests/TestResults/*.trx
+            artifacts/wo06-ci-process/process-results.json
diff --git a/scripts/wo06-process-validation.ps1 b/scripts/wo06-process-validation.ps1
new file mode 100644
index 0000000..824738a
--- /dev/null
+++ b/scripts/wo06-process-validation.ps1
@@ -0,0 +1,91 @@
+param([Parameter(Mandatory)][string]$OutputDirectory)
+$ErrorActionPreference = 'Stop'
+$PSNativeCommandUseErrorActionPreference = $false
+$repo = Split-Path $PSScriptRoot -Parent
+$output = [IO.Path]::GetFullPath($OutputDirectory)
+$allowed = [IO.Path]::GetFullPath((Join-Path $repo 'artifacts')) + [IO.Path]::DirectorySeparatorChar
+if (!$output.StartsWith($allowed, [StringComparison]::OrdinalIgnoreCase) -or (Test-Path -LiteralPath $output)) {
+    throw 'Use a new directory under repository artifacts.'
+}
+New-Item -ItemType Directory -Path $output | Out-Null
+$probe = Join-Path $repo 'tests/SmartPerformanceDoctor.UpdateRecoveryProbe/bin/x64/Release/net10.0-windows10.0.26100.0/SmartPerformanceDoctor.UpdateRecoveryProbe.exe'
+$records = [Collections.Generic.List[object]]::new()
+function Invoke-Probe([string]$Verb,[string]$Fixture,[string]$Expected) {
+    $lines = @(& $probe $Verb $Fixture 2>&1 | ForEach-Object { $_.ToString() })
+    $code = $LASTEXITCODE
+    $records.Add([pscustomobject]@{Command="$probe $Verb $Fixture";Input=$Fixture;Output=$lines;ExitCode=$code;Expected=$Expected})
+    if (($Expected -eq 'ZERO' -and $code -ne 0) -or ($Expected -eq 'NONZERO' -and $code -eq 0)) {
+        throw "Unexpected result for $Verb : $code"
+    }
+}
+try {
+    $points = @('AfterNewFileIntent','AfterNewFileCreated','AfterNewFileIdentity','BeforeNewFileRename','AfterNewFileRename',
+        'JournalTempCreated','JournalPartialWrite','JournalFlushed','JournalBeforeReplace','JournalAfterReplace','BeforeCommittedJournal')
+    foreach ($point in $points) {
+        $fixture = Join-Path $output $point
+        Invoke-Probe 'prepare' $fixture 'ZERO'
+        Invoke-Probe ('kill:'+$point) $fixture 'NONZERO'
+        if ($point -eq 'AfterNewFileCreated') {
+            Invoke-Probe 'recover' $fixture 'NONZERO'
+            Invoke-Probe 'verify-orphan' $fixture 'ZERO'
+        } else {
+            Invoke-Probe 'recover' $fixture 'ZERO'
+            Invoke-Probe 'verify' $fixture 'ZERO'
+        }
+    }
+    $fixture = Join-Path $output 'rollback-reentry'
+    Invoke-Probe 'prepare' $fixture 'ZERO'
+    Invoke-Probe 'apply-kill' $fixture 'NONZERO'
+    Invoke-Probe 'recover-kill' $fixture 'NONZERO'
+    Invoke-Probe 'recover' $fixture 'ZERO'
+    Invoke-Probe 'verify' $fixture 'ZERO'
+
+    $journalPoints = @('JournalTempCreated','JournalPartialWrite','JournalFlushed','JournalBeforeReplace','JournalAfterReplace')
+    foreach ($point in @('AfterRollbackStarted','BeforeRestoredJournal') + $journalPoints) {
+        $fixture = Join-Path $output ('recovery-'+$point)
+        Invoke-Probe 'prepare' $fixture 'ZERO'
+        Invoke-Probe 'apply-kill' $fixture 'NONZERO'
+        Invoke-Probe ('recover-kill:'+$point) $fixture 'NONZERO'
+        Invoke-Probe 'recover' $fixture 'ZERO'
+        Invoke-Probe 'verify' $fixture 'ZERO'
+    }
+    foreach ($point in $journalPoints) {
+        $fixture = Join-Path $output ('restored-journal-'+$point)
+        Invoke-Probe 'prepare' $fixture 'ZERO'
+        Invoke-Probe 'apply-kill' $fixture 'NONZERO'
+        Invoke-Probe ('recover-final-kill:'+$point) $fixture 'NONZERO'
+        Invoke-Probe 'recover' $fixture 'ZERO'
+        Invoke-Probe 'verify' $fixture 'ZERO'
+    }
+
+    $fixture = Join-Path $output 'detached-image'
+    Invoke-Probe 'prepare-self' $fixture 'ZERO'
+    $holderPath = Join-Path $fixture 'install/engine/SmartPerformanceDoctor.UpdateRecoveryProbe.exe'
+    $holder = Start-Process -FilePath $holderPath -ArgumentList @('hold',('"'+$fixture+'"')) -WindowStyle Hidden -PassThru
+    try {
+        $ready = Join-Path $fixture 'holder.pid'
+        for ($index=0; $index -lt 100 -and !(Test-Path -LiteralPath $ready); $index++) { Start-Sleep -Milliseconds 100 }
+        if (!(Test-Path -LiteralPath $ready)) { throw 'Synthetic image holder did not start.' }
+        Invoke-Probe 'apply' $fixture 'NONZERO'
+        if ([IO.File]::ReadAllText((Join-Path $fixture 'install/app.txt')) -ne 'old') { throw 'Locked image changed the installation.' }
+    } finally {
+        if (!$holder.HasExited) { $holder.Kill(); $holder.WaitForExit() }
+        $holder.Dispose()
+    }
+    Invoke-Probe 'recover' $fixture 'ZERO'
+    Invoke-Probe 'verify' $fixture 'ZERO'
+    Invoke-Probe 'apply' $fixture 'ZERO'
+    Invoke-Probe 'verify-updated' $fixture 'ZERO'
+
+    $fixture = Join-Path $output 'dll-handle-lock'
+    Invoke-Probe 'prepare-self' $fixture 'ZERO'
+    $locked = [IO.File]::Open((Join-Path $fixture 'install/engine/SmartPerformanceDoctor.UpdateRecoveryProbe.dll'), 'Open','Read','Read')
+    try { Invoke-Probe 'apply' $fixture 'NONZERO' } finally { $locked.Dispose() }
+    Invoke-Probe 'recover' $fixture 'ZERO'
+    Invoke-Probe 'verify' $fixture 'ZERO'
+    Invoke-Probe 'apply' $fixture 'ZERO'
+    Invoke-Probe 'verify-updated' $fixture 'ZERO'
+    'WINDOWS_SYNTHETIC_PROCESS=PASS; VM_E2E=NOT_TESTED; UNKNOWN_ORPHAN=PRESERVED'
+} finally {
+    $records | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath (Join-Path $output 'process-results.json') -Encoding utf8
+}
diff --git a/scripts/wo06-vm-harness.ps1 b/scripts/wo06-vm-harness.ps1
new file mode 100644
index 0000000..2c40e20
--- /dev/null
+++ b/scripts/wo06-vm-harness.ps1
@@ -0,0 +1,91 @@
+param(
+    [Parameter(Mandatory)][string]$EvidenceDirectory,
+    [Parameter(Mandatory)][string]$SnapshotId,
+    [Parameter(Mandatory)][ValidateSet('prepare','capture','apply','recover','acl-write-probe')][string]$Action,
+    [string]$InstallRoot,
+    [string]$PackagePath,
+    [string]$ExpectedVersion,
+    [string]$Outcome = 'NOT TESTED'
+)
+$ErrorActionPreference = 'Stop'
+$evidence = (Resolve-Path -LiteralPath $EvidenceDirectory).Path
+if (!(Test-Path -LiteralPath (Join-Path $evidence '.wo05-disposable-vm'))) { throw 'BLOCKED: disposable VM marker missing.' }
+if (!$SnapshotId.Trim()) { throw 'BLOCKED: record the VM snapshot ID.' }
+$machine = Get-CimInstance Win32_ComputerSystem
+if (($machine.Manufacturer + ' ' + $machine.Model) -notmatch 'VMware|VirtualBox|Virtual Machine|KVM|QEMU|Xen|Parallels') {
+    throw 'BLOCKED: a disposable VM was not identified.'
+}
+$principal = [Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()
+$elevated = $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
+$repo = Split-Path $PSScriptRoot -Parent
+$state = [ordered]@{ Utc=[DateTime]::UtcNow.ToString('o'); SnapshotId=$SnapshotId; Action=$Action;
+    Outcome=$Outcome; Elevated=$elevated; Manufacturer=$machine.Manufacturer; Model=$machine.Model }
+if ($Action -eq 'prepare') {
+    $cert = New-SelfSignedCertificate -Subject 'CN=PC-Care WO06 VM TEST ONLY' -Type CodeSigningCert -CertStoreLocation Cert:\CurrentUser\My -KeyExportPolicy NonExportable
+    $publicCert = Join-Path $evidence 'wo05-test.cer'
+    Export-Certificate -Cert $cert -FilePath $publicCert | Out-Null
+    Import-Certificate -FilePath $publicCert -CertStoreLocation Cert:\CurrentUser\Root | Out-Null
+    Import-Certificate -FilePath $publicCert -CertStoreLocation Cert:\CurrentUser\TrustedPublisher | Out-Null
+    $kit = Join-Path $repo 'tools/SmartPerformanceDoctor.VMTestKit/bin/x64/Release/net10.0-windows10.0.26100.0/SmartPerformanceDoctor.VMTestKit.exe'
+    & $kit vm-profile (Join-Path $evidence 'trust') $cert.Thumbprint
+    if ($LASTEXITCODE -ne 0) { throw 'Test profile creation failed.' }
+    $trust = Join-Path $evidence 'trust'
+    $acl = Get-Acl -LiteralPath $trust
+    $acl.SetAccessRuleProtection($true,$false)
+    $acl.SetAccessRule([Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.WindowsIdentity]::GetCurrent().User,'FullControl','ContainerInherit,ObjectInherit','None','Allow'))
+    Set-Acl -LiteralPath $trust -AclObject $acl
+    $state.TestCertificateThumbprint=$cert.Thumbprint
+} else {
+    $install = (Resolve-Path -LiteralPath $InstallRoot).Path
+    if ((Split-Path $install -Leaf) -ne 'PC-Care-WO05-Lab') { throw 'Use the dedicated PC-Care-WO05-Lab installation.' }
+    if ($Action -in @('apply','recover')) {
+        if ($elevated) { throw 'Launch UAC from the standard-user VM session.' }
+        $helper = Join-Path $install 'engine/SmartPerformanceDoctor.UpdateHelper.exe'
+        $arguments = if ($Action -eq 'apply') { @('--apply',('"'+(Resolve-Path -LiteralPath $PackagePath).Path+'"'),'--wait-pid','2147483647') } else { @('--recover') }
+        try {
+            $process = Start-Process -FilePath $helper -ArgumentList $arguments -Verb RunAs -WindowStyle Hidden -Wait -PassThru
+            $state.ExitCode=$process.ExitCode
+            $state.Outcome=if($process.ExitCode -eq 0){'PARTIAL: BOOTSTRAP-LAUNCHED'}else{'FAIL'}
+            if ($process.ExitCode -eq 0) {
+                $protected = Join-Path $env:ProgramData 'PC-Care/UpdateTransactions'
+                $receipts = @()
+                for ($index=0; $index -lt 120 -and $receipts.Count -eq 0; $index++) {
+                    $receipts = @(Get-ChildItem -LiteralPath $protected -Filter 'outcome-*.json' -File -Recurse -ErrorAction SilentlyContinue |
+                        Where-Object LastWriteTimeUtc -ge ([DateTime]::Parse($state.Utc).ToUniversalTime()))
+                    if ($receipts.Count -eq 0) { Start-Sleep -Seconds 1 }
+                }
+                $state.BootstrapOutcomes=@($receipts | ForEach-Object { Get-Content -LiteralPath $_.FullName -Raw | ConvertFrom-Json } |
+                    Where-Object InstallRoot -eq $install)
+                $committed=@($state.BootstrapOutcomes | Where-Object { $_.StageName -eq 'Committed' -and $_.Code -eq 'COMMITTED' -and $_.ExitCode -eq 0 })
+                $restored=@($state.BootstrapOutcomes | Where-Object { $_.StageName -eq 'Restored' -and $_.ExitCode -eq 0 })
+                $state.InstalledVersion=(Get-Item -LiteralPath (Join-Path $install 'PCCare.exe')).VersionInfo.FileVersion
+                if ($Action -eq 'apply' -and $ExpectedVersion -and $committed.Count -gt 0 -and
+                    ([version]$state.InstalledVersion -eq [version]$ExpectedVersion)) { $state.Outcome='PASS: COMMITTED AND VERSION VERIFIED' }
+                elseif ($Action -eq 'recover' -and $restored.Count -gt 0) { $state.Outcome='PASS: RESTORED RECEIPT VERIFIED' }
+            }
+        } catch [ComponentModel.Win32Exception] {
+            $state.ExitCode=$_.Exception.NativeErrorCode
+            $state.Outcome=if($_.Exception.NativeErrorCode -eq 1223){'UAC-CANCELLED'}else{'FAIL'}
+        }
+    }
+    $state.Files=@(Get-ChildItem -LiteralPath $install -File -Recurse | ForEach-Object {
+        [pscustomobject]@{Path=$_.FullName.Substring($install.Length); Sha256=(Get-FileHash -LiteralPath $_.FullName).Hash}
+    })
+    $protected = Join-Path $env:ProgramData 'PC-Care/UpdateTransactions'
+    if (Test-Path -LiteralPath $protected) {
+        $aclEntries=@(Get-Item -LiteralPath $protected) + @(Get-ChildItem -LiteralPath $protected -Recurse -Force | Select-Object -First 500)
+        $state.Acl=@($aclEntries | ForEach-Object {
+            $acl=Get-Acl -LiteralPath $_.FullName
+            [pscustomobject]@{Path=$_.FullName;Owner=$acl.Owner;Sddl=$acl.Sddl;Protected=$acl.AreAccessRulesProtected}
+        })
+        if ($Action -eq 'acl-write-probe') {
+            if ($elevated) { throw 'Run the write probe as a standard user.' }
+            $probe=Join-Path $protected ('wo05-probe-'+[Guid]::NewGuid().ToString('N'))
+            try { [IO.File]::WriteAllText($probe,'synthetic'); $state.Outcome='FAIL: standard-user write permitted' }
+            catch [UnauthorizedAccessException] { $state.Outcome='PASS: standard-user write denied' }
+        }
+    }
+}
+$state | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath (Join-Path $evidence ($Action+'-'+[DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss')+'.json')) -Encoding utf8
+$state.Outcome
+# Reboot and force termination require manual VM actions. This script never reboots the host.
