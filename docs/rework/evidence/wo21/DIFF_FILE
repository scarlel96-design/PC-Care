+if(![IO.Path]::IsPathFullyQualified($FixtureRoot)){throw 'WO21_ROOT_ABSOLUTE_REQUIRED'}
+$fixture=[IO.Path]::GetFullPath($FixtureRoot).TrimEnd('\')
