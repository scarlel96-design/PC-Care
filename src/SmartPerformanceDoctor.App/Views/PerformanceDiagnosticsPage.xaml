<Page x:Class="SmartPerformanceDoctor.App.Views.PerformanceDiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="{StaticResource SpdMacPagePadding}" Spacing="18">
            <TextBlock Text="성능 병목 측정" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="30초 동안 읽기 전용으로 측정합니다. 시스템 설정과 사용자 파일은 변경하지 않습니다."
                       TextWrapping="Wrap" Foreground="{StaticResource SpdMutedTextBrush}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" Content="측정 시작" Click="Start" AutomationProperties.Name="성능 측정 시작"/>
                <Button x:Name="StopButton" Content="측정 중단" Click="Stop" IsEnabled="False"/>
            </StackPanel>
            <CheckBox x:Name="ExpectedLoad" Content="게임·렌더링 등 높은 부하 작업을 의도적으로 실행 중"/>
            <Border Style="{StaticResource MacWindowPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="StatusText" Text="측정 대기" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="Progress" Maximum="30"/>
                    <TextBlock x:Name="Metrics" Text="CPU — · 메모리 — · 디스크 —" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Coverage" Text="측정되지 않은 항목은 미측정으로 표시합니다."
                               TextWrapping="Wrap" Foreground="{StaticResource SpdMutedTextBrush}"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="FindingsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource MacWindowPanelStyle}" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Foreground="{StaticResource SpdMutedTextBrush}"/>
                                <TextBlock Text="{Binding AutoApplyBlockReason}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
