+          git rev-parse 'HEAD^{tree}' | Set-Content artifacts/wo20-ci/SOURCE_TREE.txt
+          dotnet test tests/SmartPerformanceDoctor.Tests -c Release -p:Platform=x64 --no-restore -m:1 --filter 'FullyQualifiedName~WO20|FullyQualifiedName~CareFolderScanner_TempPath' --logger 'trx;LogFileName=wo20-tests.trx' -v:minimal
+          if ($LASTEXITCODE -ne 0) { throw 'WO20 tests failed' }
+          dotnet build tools/SmartPerformanceDoctor.WO20Probe -c Release -p:Platform=x64 -m:1 -v:minimal
+          if ($LASTEXITCODE -ne 0) { throw 'WO20 probe build failed' }
+          ./scripts/wo20-process-validation.ps1 -OutputDirectory artifacts/wo20-ci
+      - name: WO18 durable deletion and product safety
+        shell: pwsh
+        env:
+          VSTEST_CONNECTION_TIMEOUT: '300'
+        run: |
+          New-Item -ItemType Directory -Force artifacts/wo18-ci | Out-Null
+          $ownerProbe = Join-Path $env:RUNNER_TEMP ('wo18-owner-' + [guid]::NewGuid().ToString('N') + '.tmp')
+          [IO.File]::WriteAllBytes($ownerProbe, [byte[]]@(0))
+          $sid = [Security.Principal.WindowsIdentity]::GetCurrent().User
+          $owner = (Get-Acl -LiteralPath $ownerProbe).GetOwner([Security.Principal.SecurityIdentifier])
+          $ownerKind = if ($owner -eq $sid) { 'CurrentSid' } elseif ($owner.Value -eq 'S-1-5-32-544') { 'Administrators' } else { 'Other' }
+          @{DefaultFixtureOwner=$ownerKind;ExplicitFixtureOwner='CurrentSid';ProductionOwnershipGateChanged=$false} | ConvertTo-Json | Set-Content artifacts/wo18-ci/OWNER_ENVIRONMENT.json
+          dotnet build tests/SmartPerformanceDoctor.Tests -c Release -p:Platform=x64 --no-restore -m:1 -v:minimal
+          if ($LASTEXITCODE -ne 0) { throw 'WO18 x64 test build failed' }
+          dotnet test tests/SmartPerformanceDoctor.Tests -c Release -p:Platform=x64 --no-build --filter 'FullyQualifiedName~WO18' --logger 'trx;LogFileName=wo18-tests.trx' -v:minimal
+          if ($LASTEXITCODE -ne 0) { throw 'WO18 regression failed' }
